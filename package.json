{
  "name": "versatiles-elevation",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "generate":"tsx src/generate.ts",
    "generate:elevation": "tsx src/generate.ts elevation",
    "generate:hillshade": "tsx src/generate.ts hillshade",
    "check": "npm run check:format && npm run check:lint && npm run check:types && npm test",
    "check:format": "prettier --check .",
    "check:lint": "eslint src/",
    "check:types": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "upgrade": "vrt deps-upgrade"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@versatiles/release-tool": "^2.21.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "maplibre-gl": "^6.16.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "dependencies": {
    "@versatiles/versatiles-rs": "^5.7.0"
  }
}
