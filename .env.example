# Copy to .env and adjust. Variables already set in the environment win over .env.
# Paths are not expanded: write /home/me/... rather than ~/...

# Where `npm run generate` writes the containers: a local directory or an sftp:// URL.
# Default: data/
#OUTPUT_DIR=sftp://user@user.your-storagebox.de:23/home/incoming/

# SSH private key for sftp:// outputs, read by versatiles itself.
# Default: the SSH agent, then the usual ~/.ssh keys.
#VERSATILES_SSH_IDENTITY=/home/me/.ssh/id_ed25519

# The Mapterhorn PMTiles file to read.
# Default: https://download.mapterhorn.com/planet.pmtiles
#MAPTERHORN_URL=https://download.mapterhorn.com/planet.pmtiles
